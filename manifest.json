{
  "manifest_version": 3,
  "name": "Bplace+",
  "version": "3.1.0",
  "description": "Capture de zone, palettes .kpl et suivi de quête pour bplace.art",
  "content_scripts": [
    {
      "matches": [
        "https://bplace.art/*"
      ],
      "js": [
        "bplace-plus.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bplace+",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}